# Copy to .env and adjust. Every value is optional.

# --- Open-source LLM -------------------------------------------------------
# auto   = use Ollama if it is running, otherwise rule-based agents
# ollama = local Ollama server   (https://ollama.com)
# openai = any OpenAI-compatible server hosting an open model (vLLM, LM Studio, llama.cpp, Groq ...)
# none   = no LLM, fully rule-based (fast, offline, reproducible)
LLM_PROVIDER=auto
LLM_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed
LLM_TEMPERATURE=0.2

# --- Tools -----------------------------------------------------------------
# auto = live free API with offline fallback, live = live only, mock = offline only
WEATHER_MODE=auto
PLACES_MODE=auto
TOOL_RETRIES=1

# --- Planner ---------------------------------------------------------------
MAX_REPLANS=8
MEMORY_DB=data/memory.sqlite

# auto = live exchange rates from open.er-api.com when reachable, fixed = built-in approximate rates
FX_MODE=auto
